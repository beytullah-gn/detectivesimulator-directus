# Directus core variables (set values for your environment)
KEY=replace-with-random-string
SECRET=replace-with-strong-secret

DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=detectivesimulator
DB_USER=root
DB_PASSWORD=replace-with-db-password
PUBLIC_URL=http://localhost:8057

# Extension variables used by custom auth/game extensions
ADMIN_USER_ID=replace-with-directus-admin-user-id
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOW_API_TEST_CLIENTS=false
ALLOW_NATIVE_MOBILE_CLIENTS=true
AUTH_PROVIDERS=apple,google
AUTH_GOOGLE_DRIVER=openid
AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_GOOGLE_SCOPE=openid profile email
AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=true
AUTH_GOOGLE_DEFAULT_ROLE_ID=138adeca-dd27-46ba-a62d-fcdd50f2fe59
AUTH_GOOGLE_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/callback,https://detectivesimulator.com/auth/callback

AUTH_APPLE_DRIVER=openid
AUTH_APPLE_CLIENT_ID=replace-with-apple-service-id
AUTH_APPLE_CLIENT_SECRET=replace-with-apple-jwt-secret
AUTH_APPLE_ISSUER_URL=https://appleid.apple.com/.well-known/openid-configuration
AUTH_APPLE_SCOPE=openid email name
AUTH_APPLE_PARAMS=json:{"response_mode":"form_post"}
AUTH_APPLE_ALLOW_PUBLIC_REGISTRATION=true
AUTH_APPLE_DEFAULT_ROLE_ID=138adeca-dd27-46ba-a62d-fcdd50f2fe59
AUTH_APPLE_REDIRECT_ALLOW_LIST=http://localhost:3000/auth/callback,https://detectivesimulator.com/auth/callback

SENDER_NET_ACCESS_TOKEN=replace-with-sender-token
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_MAX_TOKENS=450
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-key
REVENUECAT_SCENARIO_ENTITLEMENT_ID=scenario_access
REVENUECAT_TIMEOUT_MS=15000
GAME_BODY_LIMIT=1mb
MAX_HINTS_PER_SESSION=3
